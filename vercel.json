{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__artha_path__=/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index?__artha_path__=/static/$1"
    },
    {
      "source": "/((?!api/|static/).*)",
      "destination": "/api/index?__artha_path__=/index.html"
    }
  ]
}
